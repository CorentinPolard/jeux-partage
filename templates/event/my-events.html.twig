{% extends "base.html.twig" %}

{% block title %}Mes événements{% endblock %}

{% block main %}
<h1>Mes événements</h1>
<section class="organized-events-section">
    <h2>Les événements que j'organise</h2>
    {% if organizedEvents|length == 0 %}
    Vous n'avez pas encore organisé d'événements.
    {% endif %}
    {% for event in organizedEvents %}
    <div>
        {{ event.title }}
        {{ event.eventAt|date("d/m/Y") }}
    </div>
    {% endfor %}
</section>
<section class="joined-events-section">
    <h2>Les événements auxquels je participe</h2>
    {% if joinedEvents|length == 0 %}
    Vous n'êtes inscrit à aucun événements.
    {% endif %}
    {% for event in joinedEvents %}
    <div>
        {{ event.title }}
        {{ event.eventAt|date("d/m/Y") }}
    </div>
    {% endfor %}
</section>
{% endblock %}