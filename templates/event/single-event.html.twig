{% extends 'base.html.twig' %}

{% block title %}{{event.title}}{% endblock %}

{% block main %}
<button>Consulter les événements</button>
{% if app.user is same as(event.organizer) %}
<a href="{{ path('app_edit_event', {id: event.id}) }}">Modifier l'événement</a>
{% endif %}
{% if app.user and app.user in event.participants %}
<a class="button-link" href="{{ path('app_unregister_event', {id: event.id}) }}">Se désinscrire</a>
{% endif %}
<h1>{{event.title}}</h1>
<p>{{event.description}}</p>
<div class="event-money">
    <img class="event-icon" src="{{ asset('images/icones/money-green-icon.svg') }}"
        alt="Illustration d'un billet de banque">
    {% if event.isFree %}
    <p>Gratuit</p>
    {% else %}
    <p>Dépenses à prévoir</p>
    {% endif %}
</div>
<div class="event-duration">
    <img class="event-icon" src="{{ asset('images/icones/clock-red-icon.svg') }}" alt="Illustration d'une horloge">
    <p>Durée moyenne prévue: {{event.duration}}minutes</p>
</div>
<div class="event-date-place-container">
    <div class="event-date">
        <img class="event-icon" src="{{ asset('images/icones/date-red-icon.svg') }}" alt="Illustration d'un calendrier">
        <p>{{event.eventAt.date | date("d/m/Y à H\\hi")}}</p>
    </div>
    <div class="event-place">
        <img class="event-icon" src="{{ asset('images/icones/location-red-icon.svg') }}" alt="Pointeur d'une
                    carte">
        <p>{{event.address.street}} {{event.address.zipcode}} {{event.address.city}}</p>
    </div>
</div>
{# A FAIRE !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! #}
<div>leaflet</div>
<section class="games-container">
    <h2>Les jeux</h2>
    {% for game in event.games %}
    <a class="game-link" href="{{ path('app_show_game', {id: game.id}) }}">
        <div class="game-container">
            <img class="game-image" src="{{ asset('images/uploads/games/' ~ game.imageFileName)}}"
                alt="Illustration de {{game.name}}">
            <p>{{game.name}}</p>
            <p>{{game.category.label}}</p>
        </div>
    </a>
    {% endfor %}
</section>
<section class="participants-container">
    <h2>Les participants</h2>
    <p>{{event.organizer.fullName}}</p>
    {% for participant in event.participants %}
    <p>{{participant.getFullName}}</p>
    {% endfor %}
</section>
{# Faire messagerie #}
<section class="messages">
    Messagerie
</section>
{% endblock %}