{% extends 'base.html.twig' %}

{% block title %}Les événements{% endblock %}

{% block main %}
<h1>Jouez ensemble, créez vos événements !</h1>
<img src="" alt="">
<a href="{{ path('app_create_event') }}">Créer votre événement</a>
<section class="events-section">
    <h2>Les événements</h2>
    {% for event in events %}
    <div class="event-container">
        <div class="event-organizer">
            <img class="profil-picture"
                src="{{ asset('images/uploads/profil-pictures/' ~ event.organizer.profilPicture) }}"
                alt="Photo de profil de {{event.organizer.firstName ~ event.organizer.lastName}}">
            <p>{{event.organizer.firstName }} {{event.organizer.lastName}}</p>
        </div>
        <h3>{{ event.title }}</h3>
        <p>{{ event.description }}</p>
        <div class="event-date-place-container">
            <div class="event-place">
                <img class="event-icon" src="images/icones/location-black-icon.svg" alt="Pointeur d'une carte">
                <p>{{event.address.street}} {{event.address.zipcode}} {{event.address.city}}</p>
            </div>
            <div class="event-date">
                <img class="event-icon" src="images/icones/date-black-icon.svg" alt="Illustration d'un calendrier">
                <p>{{event.eventAt.date | date("d/m/Y à H\hi")}}</p>
            </div>
        </div>
        <div class="register">
            {% if event.maxNumberOfParticipants %}
            {% set totalParticipants = event.participants|length + 1 %}
            {% set remaining = event.maxNumberOfParticipants - totalParticipants %}
            <p>
                {{totalParticipants}}/{{event.maxNumberOfParticipants}} ({{remaining > 1 ? remaining ~ ' places
                restantes' : '1 place restante'}})
            </p>
            {% else %}
            <p>{{(event.participants|length + 1)}} inscrit{% if (event.participants|length + 1) > 1 %}s{% endif %}</p>
            {% endif %}
            <button>S'inscrire</button>
        </div>
    </div>
    {% endfor %}
</section>
{% endblock %}