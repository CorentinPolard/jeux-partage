{% extends "base.html.twig" %}

{% block title %}Mes évènements{% endblock %}

{% block main %}
<h1>Mes évènements</h1>
<section class="organized-events-section">
    <h2>Les évènements que j'organise</h2>
    {% if organizedEvents|length == 0 %}
    Vous n'avez pas encore organisé d'évènements.
    {% endif %}
    {% for event in organizedEvents %}
    <div class="my-event-container">
        <h3>{{ event.title }}</h3>
        <div class="event-date-place-container my-event-date-place">
            <div class="event-date">
                <img class="event-icon" src="{{ asset('images/icones/date-red-icon.svg') }}"
                    alt="Illustration d'un calendrier">
                <time datetime="{{event.eventAt.date | date(" Y-m-dTH:i")}}">{{event.eventAt.date | date("d/m/Y à
                    H\\hi")}}</time>
            </div>
            <div class="event-place">
                <img class="event-icon" src="{{ asset('images/icones/location-red-icon.svg') }}" alt="Pointeur d'une
                    carte">
                {% if event.address %}
                <address>{{event.address.getFullAddress }}</address>
                {% else %}
                <address>Adresse non renseignée</address>
                {% endif %}
            </div>
        </div>
        <div class="my-event-actions-container">
            <a class="button-link" href="{{ path('app_show_event', {id: event.id}) }}">Voir</a>
            <a class="button-link" href="{{ path('app_edit_event', {id: event.id}) }}">Modifier</a>
            <form method="post" action="{{ path('app_delete_event', {'id': event.id}) }}" class="delete-form">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_event_' ~ event.id) }}">
                <button type="submit" class="delete-button" aria-label="Supprimer {{ event.title }}">
                    Supprimer
                </button>
            </form>
        </div>
    </div>
    {% endfor %}
</section>
<section class="joined-events-section">
    <h2>Les évènements auxquels je participe</h2>
    {% if joinedEvents|length == 0 %}
    Vous n'êtes inscrit à aucun évènements.
    {% endif %}
    {% for event in joinedEvents %}
    <div class="my-event-container">
        <h3>{{ event.title }}</h3>
        <div class="event-date-place-container my-event-date-place">
            <div class="event-date">
                <img class="event-icon" src="{{ asset('images/icones/date-red-icon.svg') }}"
                    alt="Illustration d'un calendrier">
                <time datetime="{{event.eventAt.date | date(" Y-m-dTH:i")}}">{{event.eventAt.date | date("d/m/Y à
                    H\\hi")}}</time>
            </div>
            <div class="event-place">
                <img class="event-icon" src="{{ asset('images/icones/location-red-icon.svg') }}" alt="Pointeur d'une
                    carte">
                {% if event.address %}
                <address>{{event.address.getFullAddress }}</address>
                {% else %}
                <p>Adresse non renseignée</p>
                {% endif %}
            </div>
        </div>
        <div class="my-event-actions-container">
            <a class="button-link" href="{{ path('app_show_event', {id: event.id}) }}">Voir</a>
            <form action="{{ path('app_register_event', {id: event.id}) }}" method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('register_event_' ~ event.id) }}">
                <button type="submit" class="button-link">Se désinscrire</button>
            </form>
        </div>
    </div>
    {% endfor %}
</section>
{% include "components/deleteModal.html.twig" %}
{% endblock %}