{% extends "base.html.twig" %}

{% block title %}Créer mon événement{% endblock %}

{% block stylesheets %}
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.css" rel="stylesheet">
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js"></script>
<script src="{{ asset('scripts/searchGame.js') }}" defer></script>
{% endblock %}

{% block main %}
<h1>Créer mon événement</h1>

{{ form_start(form) }}
{{ form_row(form.title) }}
{{ form_row(form.description) }}
{{ form_row(form.address) }}
{{ form_row(form.eventAt) }}
{{ form_row(form.maxNumberOfParticipants) }}
{{ form_row(form.duration) }}
{{ form_row(form.isFree) }}
{{ form_row(form.games) }}

<button type="submit">Créer</button>
{{ form_end(form) }}

<a href="{{ path('app_events') }}">Retourner à la liste des événements</a>
{% endblock %}