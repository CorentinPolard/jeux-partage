{% set start = (page - 2) > 0 ? (page - 2) : 1 %}
{% set end = (page + 2) < maxPage ? (page + 2) : maxPage %} <div class="pagination">
    {% if page > 1 %}
    <div class="previous">
        <a href="{{ path(route, {
        page: page - 1 }) }}">Page précédente</a>
    </div>
    {% endif %}
    <div class="pages-numbers">
        {% if start > 1 %}
        <a href="{{ path(route, {page: 1}) }}">
            1
        </a>
        <p>...</p>
        {% endif %}

        {% for i in start..end %} <a href="{{ path(route, {page: i}) }}">
            {{i}}
        </a>
        {% endfor %}

        {% if end < maxPage %} <p>...</p>
            <a href="{{ path(route, {page: maxPage}) }}">
                {{maxPage}}
            </a>
            {% endif %}
    </div>
    {% if page < maxPage %} <div class="next">
        <a href="{{ path(route, { page: page + 1 }) }}">
            Page suivante
        </a>
        </div>
        {% endif %}
        </div>