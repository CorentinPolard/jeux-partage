<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description"
        content="Organisez et participez à des événements de jeux de société, rencontrez d'autres passionnés et découvrez de nouvelles parties amusantes près de chez vous.">
    <title>{% block title %}Jeux partage{% endblock %}</title>

    <link rel="icon" href="{{ asset('images/favicon.svg') }}" type="image/svg+xml" />

    {% block stylesheets %}
    {{ encore_entry_link_tags('styles/app')|replace({'rel="stylesheet"': 'rel="stylesheet"
    data-turbo-track="reload"'})|raw }}
    {% endblock %}

    {% block javascripts %}
    {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>

<body>
    <header>
        <div class="mobile-container">
            <a class="logo-container" href="{{ path('app_home')}}">
                <img class="logo" src="{{ asset('images/logo.webp')}}" alt="Logo du site représentant un dé">
            </a>
            <button class="burger-btn" aria-label="Ouvrir le menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>

        <nav>
            <ul class="nav-list">
                <li><a href="{{ path('app_home') }}">Accueil</a></li>
                <li><a href="{{ path('app_events') }}">Les événements</a></li>
                <li><a href="#">Mes événements</a></li>
                <li><a href="{{ path('app_games') }}">Les jeux</a></li>
                {% if not app.user %}
                <li><a href="{{ path('app_login') }}">Se connecter</a></li>
                <li><a href="{{ path('app_register') }}">S'inscrire</a></li>
                {% else %}
                <li><a href="{{ path('app_profile' )}}">Mon profil</a></li>
                {% if is_granted("ROLE_ADMIN") %}
                <li><a href="{{ path('app_admin') }}">Fonctions Admin</a></li>
                {% endif %}
                <li><a href="{{ path('app_logout') }}">Se déconnecter</a></li>
                {% endif %}
            </ul>
        </nav>
    </header>

    <main>
        {% for label, messages in app.flashes %}
        {% for message in messages %}
        <div class="flash-{{ label }}">
            <p class="flash">
                <strong>{{ message }}</strong>
            </p>
        </div>
        {% endfor %}
        {% endfor %}
        {% block main %}
        {% endblock %}
    </main>
    <footer>
        <p>Footer</p>
    </footer>
</body>

</html>