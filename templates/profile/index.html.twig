{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block main %}
<h1>Mon profil</h1>
<a href="{{ path('app_edit_profile') }}">Modifier mes informations</a>
<a href="{{ path('app_edit_password') }}">Modifier mon mot de passe</a>
<img class="my-profile-picture" src="{{ asset('images/uploads/profil-pictures/' ~ user.profilePicture) }}"
    alt="Photo de profil de {{user.getFullName}}">
<p>Nom: {{user.lastname}}</p>
<p>Prénom: {{user.firstname}}</p>
<p>Nombre d'évènements organisés: {{user.getNumberOfEventsOrganized}}</p>

{% if not is_granted('ROLE_ADMIN') %}
<form id="delete-account-form" class="delete-form" method="post" action="{{ path('app_delete_profile') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete_account') }}">
    <button type="submit" id="delete-account-button" class="delete-button" aria-label="Supprimer mon compte">Supprimer
        mon compte</button>
</form>

<div id="modal-background" class="hidden" aria-hidden="true">
    <div id="modal" class="modal">
        <span class="modal-close-button close-modal" aria-label="Fermer la fenêtre">&times;</span>
        <h2>Confirmer la suppression du compte</h2>
        <p>
            Êtes-vous sur de vouloir supprimer votre compte et vos données ?
            <br>
            Cette action est irréversible.
        </p>
        <div class="modal-actions">
            <button type="button" class="close-modal">Annuler</button>
            <button type="button" id="confirm-delete-account" class="delete-entity">Supprimer</button>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}