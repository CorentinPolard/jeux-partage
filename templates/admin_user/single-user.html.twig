{% extends 'admin-base.html.twig' %}

{% block title %}Menu administrateur - utilisateurs{% endblock %}

{% block main %}
<section class="single-user-container">
    <h1>{{ user.getFullName }}</h1>
    <div class="user-name-container">
        <p><strong>Nom :</strong> {{ user.lastname }}</p>
        <p><strong>Prénom :</strong> {{ user.firstname }}</p>
    </div>
    <p class="biography"><strong>Biographie :</strong> {{ user.biography|nl2br }}</p>
    <section class="user-events-section">
        <h2>Ses évènements</h2>
        <p><strong>Nombre d'évènements organisés :</strong> {{ user.getNumberOfEventsOrganized }}</p>
        {% if user.getNumberOfEventsOrganized|length > 0 %}
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Titre</th>
                    <th>Date de l'évènement</th>
                    <th>Lieu</th>
                </tr>
            </thead>
            <tbody>
                {% for event in user.organizedEvents %}
                <tr>
                    <td>{{ event.id }}</td>
                    <td class="event-title"><a href="{{ path('app_admin_show_event', {id: event.id}) }}">{{ event.title
                            }}</a></td>
                    <td>{{ event.eventAt|date('d/m/Y H:i')}}</td>
                    {% if event.address %}
                    <td>{{event.address.getFullAddress }}</td>
                    {% else %}
                    <td>Adresse non renseignée</td>
                    {% endif %}
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% endif %}

    </section>

    <section class="user-messages-section">
        <h2>Ses messages</h2>
        <p><strong>Nombre de messages postés :</strong> {{ user.getNumberOfMessages }}</p>
        {% if user.messages|length > 0 %}
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Contenu</th>
                    <th>Date de création</th>
                    <th>Évènement associé</th>
                </tr>
            </thead>
            <tbody>
                {% for message in user.messages %}
                <tr>
                    <td>{{ message.id }}</td>
                    <td>{{ message.content }}</td>
                    <td>{{ message.createdAt ? message.createdAt|date('d/m/Y H:i') : '' }}</td>
                    <td class="event-title"><a href="{{ path('app_admin_show_event', {id: message.event.id}) }}">{{
                            message.event.title}}</a></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </section>
</section>
{% endblock %}