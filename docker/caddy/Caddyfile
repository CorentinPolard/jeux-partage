##########################################################
# 1️⃣ Hub Mercure
# On utilise un sous-domaine dédié pour Mercure
# Exemple : mercure.jeuxpartage.fr
##########################################################
mercure.jeuxpartage.fr {
    # Compression automatique
    encode gzip

    # Reverse proxy vers le container Mercure
    reverse_proxy mercure:80

    # Headers CORS nécessaires pour EventSource en HTTPS
    header {
        Access-Control-Allow-Origin "https://www.jeuxpartage.fr https://jeuxpartage.fr"
        Access-Control-Allow-Credentials true
        Access-Control-Allow-Headers *
        Access-Control-Expose-Headers *
    }

    # Optionnel : ajouter sécurité supplémentaire
    # header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
}

##########################################################
# 2️⃣ Site principal
# Symfony / PHP-FPM derrière Caddy
# Gère le domaine principal + www
##########################################################
jeuxpartage.fr, www.jeuxpartage.fr {
    # Compression automatique
    encode gzip

    # Reverse proxy vers PHP-FPM (container php)
    reverse_proxy php:9000

    # Sécurité headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
    }
}
