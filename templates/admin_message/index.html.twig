{% extends 'admin-base.html.twig' %}

{% block title %}Menu administrateur - messages{% endblock %}

{% block main %}
<h1>Gestion des messages</h1>
{% for event in events %}
<section class="admin-messages-section">
    <h2 class="event-title">{{ event.title }}</h2>
    <table class="messages-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Contenu</th>
                <th>Autheur</th>
                <th>Evènement</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            {% for message in event.messages %}
            <tr>
                <td>{{ message.id }}</td>
                <td>{{ message.content }}</td>
                <td>
                    <a href="{{ path('app_admin_show_user', {id: message.user.id}) }}">{{ message.user.getFullName
                        }}</a>
                </td>
                <td>
                    <a href="{{ path('app_admin_show_event', {id: message.event.id}) }}">{{ event.title }}</a>
                </td>
                <td class="admin-actions">
                    <form method="post" action="{{ path('app_admin_delete_message', {'id': message.id}) }}"
                        class="delete-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_message_' ~ message.id) }}">
                        <button type="submit" class="delete-button" aria-label="Supprimer {{ message.id }}">
                            <img class="admin-action" src="{{ asset('images/icones/delete-icon.svg') }}"
                                alt="Icone de poubelle">
                        </button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</section>
{% endfor %}
{% include "components/pagination.html.twig" %}
{% include 'components/deleteModal.html.twig' %}
{% endblock %}