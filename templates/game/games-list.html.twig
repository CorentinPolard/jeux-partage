{% extends 'base.html.twig' %}

{% block title %}Les jeux{% endblock %}

{% block meta_description %}
Explorez notre collection de jeux de société : trouvez de nouveaux jeux à découvrir, consultez les règles et préparez
vos prochaines parties entre amis ou en famille.
{% endblock %}

{% block main %}
<section class="games-section">
    <h1>Liste des jeux enregistrés</h1>
    {% for game in games %}
    <a class="game-link" href="{{ path('app_show_game', {id: game.id}) }}">
        <div class="game-container">
            {% if game.imageFileName %}
            <img class="game-image" src="{{ asset('images/uploads/games/' ~ game.imageFileName) }}"
                alt="Illustration de {{ game.name }}." />
            {% endif %}
            <p class="game-title">{{ game.name }}</p>
        </div>
    </a>
    {% endfor %}
    {% include "components/pagination.html.twig" %}
</section>
{% endblock %}