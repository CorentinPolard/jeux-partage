{% extends 'base.html.twig' %}

{% block title %}S'inscrire{% endblock %}

{% block meta_description %}
Rejoignez notre communauté de passionnés de jeux de société ! Créez votre compte pour organiser ou participer à des
événements et partager vos parties.
{% endblock %}

{% block main %}
<h1>Inscription</h1>

{{ form_errors(registrationForm) }}

{{ form_start(registrationForm, {'attr': {'id': 'registrationForm'}}) }}
{{ form_row(registrationForm.email) }}
<div class="form-group">
    <p class="password-help hidden">
        <small>
            Votre mot de passe doit contenir au moins :
            <span class="password-validator">12 caractères</span>,
            <span class="password-validator">une minuscule</span>,
            <span class="password-validator">une majuscule</span>,
            <span class="password-validator">un chiffre</span>
            et <span class="password-validator">un caractère spécial</span>.
        </small>
    </p>
    {{ form_widget(registrationForm.plainPassword) }}
    {{ form_errors(registrationForm.plainPassword) }}
</div>
{{ form_row(registrationForm.firstName) }}
{{ form_row(registrationForm.lastName) }}
{{ form_row(registrationForm.agreeTerms, { 'row_attr': {'class': 'checkbox-container'} }) }}

<button type="submit" class="btn">S'inscrire</button>
{{ form_end(registrationForm) }}
{% endblock %}