{% extends 'base.html.twig' %}

{% block title %}Les jeux{% endblock %}

{% block main %}
<section class="games-section">
    <h1>Liste des jeux enregistrés</h1>
    {% for game in games %}
    <a class="game-link" href="{{ path('app_show_game', {id: game.id}) }}">
        <div class="game-container">
            {% if game.imageFileName %}
            <img class="game-image" src="{{ asset('images/uploads/games/' ~ game.imageFileName) }}"
                alt="Illustration de {{ game.name }}." />
            {% endif %}
            <p class="game-title">{{ game.name }}</p>
        </div>
    </a>
    {% endfor %}
    <div class="pagination">
        <div class="previous">
            {% if page > 1 %}
            <a href="{{ path('app_games', {page: page - 1}) }}">Page précédente</a>
            {% endif %}
        </div>
        <div class="pages-numbers">
            {% for i in 1..maxPages %}
            <a href="{{ path('app_games', {page: i})}}">{{i}}</a>
            {% endfor %}
        </div>
        <div class="next">
            {% if page < maxPages %} <a href="{{ path('app_games', {page: page + 1}) }}">Page suivante</a>
                {% endif %}
        </div>
    </div>
</section>
{% endblock %}