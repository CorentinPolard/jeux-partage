{% extends 'base.html.twig' %}

{% block title %}Les événements{% endblock %}

{% block main %}
{% for label, messages in app.flashes %}
{% for message in messages %}
<div class="flash-{{ label }}">
    {{ message }}
</div>
{% endfor %}
{% endfor %}
<h1>Jouez ensemble, créez vos événements !</h1>
<img src="" alt="">
<a href="{{ path('app_create_event') }}">Créer votre événement</a>
<section class="events-section">
    <h2>Les événements</h2>
    {% for event in events %}
    {% if app.user and app.user is same as(event.organizer) %}
    <a href="{{ path('app_show_event', {id: event.id}) }}">
        {% include "/components/event-card.html.twig" %}
    </a>
    {% else %}
    {% include "/components/event-card.html.twig" %}
    {% endif %}
    {% endfor %}
</section>
{% endblock %}