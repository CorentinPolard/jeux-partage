{% extends "base.html.twig" %}

{% block title %}Modifier mon évènement{% endblock %}

{% block main %}
<h1>Modifier mon évènement</h1>

{{ form_start(form, {'attr': {'id': 'eventForm'}}) }}
{{ form_row(form.title) }}
{{ form_row(form.description) }}
{{ form_row(form.games) }}
<div class="street">
    {{ form_row(form.address.street, {'attr': {'autocomplete': 'off'}}) }}
    <ul id="addresses-suggestions" class="addresses-suggestions hidden"></ul>
</div>
{{ form_row(form.address.postcode) }}
{{ form_row(form.address.city) }}
{{ form_row(form.eventAt) }}
{{ form_row(form.maxNumberOfParticipants) }}
{{ form_row(form.duration) }}
{{ form_row(form.isFree, { 'row_attr': {'class': 'checkbox-container'} }) }}
<button type="submit">Modifier</button>
{{ form_end(form) }}

<a href="{{ path('app_show_event', {id: event.id}) }}">Retourner à la fiche de l'évènement</a>
{% endblock %}