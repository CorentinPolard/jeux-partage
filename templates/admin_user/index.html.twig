{% extends 'admin-base.html.twig' %}

{% block title %}Menu administrateur - utilisateurs{% endblock %}

{% block main %}
<h1>Gestion des utilisateurs</h1>
<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Photo de profil</th>
            <th>Evenements organisés</th>
            <th>Message envoyés</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for user in users %}
        <tr>
            <td>{{ user.id }}</td>
            <td>{{ user.lastname }}</td>
            <td>{{ user.firstname }}</td>
            <td><img class="profil-picture" src="{{ asset('images/uploads/profil-pictures/' ~ user.profilePicture) }}"
                    alt="Photo de profil de {{user.getFullName}}"></td>
            <td>{{ user.getNumberOfEventsOrganized }}</td>
            <td>{{ user.getNumberOfMessages }}</td>
            <td class="admin-actions">
                <a href="{{ path('app_admin_show_user', {'id': user.id}) }}" aria-label="Voir {{ user.getFullName }}">
                    <img class="admin-action" src="{{ asset('images/icones/read-icon.svg') }}" alt="Icone d'oeil">
                </a>
                <a href="{{ path('app_admin_block_user', {'id': user.id}) }}"
                    aria-label="Bloquer l'accès au site pour {{ user.getFullName }}">
                    {% if user.isBlocked %}
                    <img class="admin-action" src="{{ asset('images/icones/unblocked-red-icon.svg') }}"
                        alt="Icone d'accès autorisé">
                    {% else %}
                    <img class="admin-action" src="{{ asset('images/icones/blocked-red-icon.svg') }}"
                        alt="Icone d'accès interdit">
                    {% endif %}
                </a>
            </td>
        </tr>
        {% else %}
        <tr>
            <td colspan="6">Aucun évènement trouvé.</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% include 'components/pagination.html.twig' %}
{% include 'components/deleteModal.html.twig' %}
{% endblock %}