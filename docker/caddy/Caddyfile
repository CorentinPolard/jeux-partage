jeuxpartage.fr {
    # Redirect non-www to www to enforce a single origin and avoid CORS issues
    redir https://www.jeuxpartage.fr{uri} permanent
}

www.jeuxpartage.fr {
    root * /app/public
    encode gzip zstd
    file_server

    # Ensure requests to the Mercure hub are proxied to the mercure container
    @mercure {
        path /.well-known/mercure*
    }
    reverse_proxy @mercure mercure:80 {
        header_up Host {host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote_host}

        # CORS headers (obligatoire pour browser)
        header_down Access-Control-Allow-Origin https://www.jeuxpartage.fr
        header_down Access-Control-Allow-Credentials true
    }

    php_fastcgi php:9000

    header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    header X-Frame-Options "SAMEORIGIN"
    header X-Content-Type-Options "nosniff"

    # (Mercure proxy handled above with a dedicated matcher)

    try_files {path} /index.php?{query}
}