##########################################################
# 1️⃣ Hub Mercure
# On utilise un sous-domaine dédié pour Mercure
# Exemple : mercure.jeuxpartage.fr
##########################################################
mercure.jeuxpartage.fr {
    # Compression automatique
    encode gzip

    # Reverse proxy vers le container Mercure
    reverse_proxy mercure:80

    # Secure CORS: echo the request Origin back and allow credentials
    # This lets only the requesting origin access the hub (when allowed by Mercure service)
    header {
        Access-Control-Allow-Origin "{http.request.header.Origin}"
        Access-Control-Allow-Credentials "true"
        Access-Control-Allow-Headers "*"
        Access-Control-Expose-Headers "*"
        Vary "Origin"
    }

    # Optionnel : ajouter sécurité supplémentaire
    # header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
}

##########################################################
# 2️⃣ Site principal
# Symfony / PHP-FPM derrière Caddy
# Gère le domaine principal + www
##########################################################
jeuxpartage.fr, www.jeuxpartage.fr {
    # Compression automatique
    encode gzip

    # Serve public files and forward PHP requests to php-fpm
    root * /app/public
    file_server
    php_fastcgi php:9000

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
    }
}
