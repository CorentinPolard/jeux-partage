{% extends "admin-base.html.twig" %}

{% block title %}Ajouter un jeu{% endblock %}

{% block main %}
<h1>Ajouter un jeu à la bibliothèque générale</h1>

{{ form_start(form) }}
{{ form_row(form.name) }}
{{ form_row(form.description) }}
{{ form_row(form.image) }}
{{ form_row(form.minimumNumberOfPlayers) }}
{{ form_row(form.maximumNumberOfPlayers) }}
{{ form_row(form.averageGameDuration) }}
{{ form_row(form.category) }}
<button type="submit">Ajouter</button>
{{ form_end(form) }}

<a href="{{ path('app_admin_games') }}">Retourner à la liste des jeux</a>
{% endblock %}