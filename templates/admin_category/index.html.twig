{% extends 'admin-base.html.twig' %}

{% block title %}Menu administrateur - catégories{% endblock %}

{% block main %}
<h1>Gestion des catégories de jeux</h1>
<a href="{{ path('app_admin_create_category') }}">Ajouter une catégorie</a>
<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for category in categories %}
        <tr>
            <td>{{ category.id }}</td>
            <td>{{ category.label }}</td>
            <td class="admin-actions">
                <a href="{{ path('app_admin_edit_category', {'id': category.id}) }}"
                    aria-label="Modifier {{ category.label }}">
                    <img class="admin-action" src="{{ asset('images/icones/edit-icon.svg') }}" alt="Icone de crayon">
                </a>
                <form method="post" action="{{ path('app_admin_delete_category', {'id': category.id}) }}"
                    class="delete-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_category_' ~ category.id) }}">
                    <button type="submit" class="delete-button" aria-label="Supprimer {{ category.label }}">
                        <img class="admin-action" src="{{ asset('images/icones/delete-icon.svg') }}"
                            alt="Icone de poubelle">
                    </button>
                </form>
            </td>
        </tr>
        {% else %}
        <tr>
            <td colspan="6">Aucune catégorie trouvée.</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% include "components/pagination.html.twig" %}
{% include 'components/deleteModal.html.twig' %}
{% endblock %}