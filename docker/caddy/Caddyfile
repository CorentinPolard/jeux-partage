jeuxpartage.fr, www.jeuxpartage.fr {
    root * /app/public
    encode gzip zstd
    file_server

    php_fastcgi php:9000

    header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    header X-Frame-Options "SAMEORIGIN"
    header X-Content-Type-Options "nosniff"

    # Proxy Mercure hub to the Mercure service in Docker
    # This ensures EventSource requests to /.well-known/mercure are forwarded
    # to the dedicated Mercure container instead of being handled by Caddy/PHP.
    reverse_proxy /.well-known/mercure* mercure:80

    try_files {path} /index.php?{query}
}