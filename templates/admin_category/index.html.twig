{% extends 'admin-base.html.twig' %}

{% block title %}Menu administrateur - catégories{% endblock %}

{% block main %}
<h1>Gestion des catégories de jeux</h1>
<a href="{{ path('app_admin_create_category') }}">Ajouter une catégorie</a>
<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for category in categories %}
        <tr>
            <td>{{ category.id }}</td>
            <td>{{ category.label }}</td>
            <td class="admin-actions">
                <a href="{{ path('app_admin_edit_category', {'id': category.id}) }}"
                    aria-label="Modifier {{ category.label }}">
                    <img class="admin-action" src="{{ asset('images/icones/edit-icon.svg') }}" alt="Icone de crayon">
                </a>
                <a class="delete-button" href="{{ path('app_admin_delete_category', {'id': category.id}) }}"
                    aria-label="Supprimer {{ category.label }}">
                    <img class=" admin-action" src="{{ asset('images/icones/delete-icon.svg') }}"
                        alt="Icone de poubelle">
                </a>
            </td>
        </tr>
        {% else %}
        <tr>
            <td colspan="6">Aucune catégorie trouvée.</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
<div class="pagination">
    {% if page > 1 %}
    <div class="previous">
        <a href="{{ path('app_admin_categories', {
        page: page - 1 }) }}">Page précédente</a>
    </div>
    {% endif %}
    <div class="pages-numbers">
        {% for i in 1..maxPages %}
        <a href="{{ path('app_admin_categories', {
        page: i}) }}">
            {{i}}
        </a>
        {% endfor %}
    </div>
    {% if page < maxPages %} <div class="next">
        <a href="{{ path('app_admin_categories', { page: page + 1 }) }}">
            Page suivante
        </a>
</div>
{% endif %}
</div>
{% include 'components/deleteModal.html.twig' %}
{% endblock %}