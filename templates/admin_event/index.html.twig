{% extends 'admin-base.html.twig' %}

{% block title %}Menu administrateur - évènements{% endblock %}

{% block main %}
<h1>Gestion des évènements</h1>
<a href="{{ path('app_admin_create_event') }}">Ajouter un évènement</a>
<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Titre</th>
            <th>Date de l'évènement</th>
            <th>Lieu</th>
            <th>Organisateur</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for event in events %}
        <tr>
            <td>{{ event.id }}</td>
            <td>{{ event.title }}</td>
            <td>{{ event.eventAt ? event.eventAt|date('d/m/Y H:i') : '' }}</td>
            <td>{{event.address.getFullAddress }}</td>
            <td><a href="{{ path('app_admin_show_user', {id: event.organizer.id}) }}">{{event.organizer.getFullName
                    }}</a></td>
            <td class="admin-actions">
                <a href="{{ path('app_admin_show_event', {'id': event.id}) }}" aria-label="Voir {{ event.title }}">
                    <img class="admin-action" src="{{ asset('images/icones/read-icon.svg') }}" alt="Icone d'oeil">
                </a>
                <a href="{{ path('app_admin_edit_event', {'id': event.id}) }}" aria-label="Modifier {{ event.title }}">
                    <img class="admin-action" src="{{ asset('images/icones/edit-icon.svg') }}" alt="Icone de crayon">
                </a>
                <a class="delete-button" href="{{ path('app_admin_delete_event', {'id': event.id}) }}"
                    aria-label="Supprimer {{ event.title }}">
                    <img class="admin-action" src="{{ asset('images/icones/delete-icon.svg') }}"
                        alt="Icone de poubelle">
                </a>
            </td>
        </tr>
        {% else %}
        <tr>
            <td colspan="6">Aucun évènement trouvé.</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% include 'components/deleteModal.html.twig' %}
{% endblock %}