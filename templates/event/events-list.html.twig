{% extends 'base.html.twig' %}

{% block title %}Les évènements{% endblock %}

{% block meta_description %}
Découvrez tous les événements de jeux de société organisés par notre communauté. Rejoignez des parties, rencontrez
d’autres passionnés et partagez votre passion pour les jeux de société.
{% endblock %}

{% block main %}
<h1>Jouez ensemble, créez vos évènements !</h1>
<img class="events-list-page-image" src="{{ asset('images/boardgames.webp') }}"
    alt="Illustration de plusieurs jeux de société." width="820" height="437" loading="eager" fetchpriority="high" />
<section class="events-section">
    <a class="button-link" href="{{ path('app_create_event') }}">Créer votre évènement</a>
    <h2>Les évènements</h2>
    <section class="filter-section">
        <h2>Filtrer les évènements</h2>
        <a href="{{ path('app_events') }}" class="button-link">Réinitialiser</a>
        {{ form_start(eventForm, {'attr': {'class': 'filterForm'}}) }}
        {{ form_row(eventForm.city) }}
        {{ form_row(eventForm.departmentNumber) }}
        <button type="submit">Chercher</button>
        {{ form_end(eventForm) }}
    </section>
    {% if events|length == 0 %}
    <p>Pas encore d'évènements ici.</p>
    {% endif %}
    {% for event in events %}
    <div class="event-container">
        <div class="event-organizer">
            <img class="profil-picture"
                src="{{ asset('images/uploads/profil-pictures/' ~ event.organizer.profilePicture) }}"
                alt="Photo de profil de {{event.organizer.getFullName}}">
            <p>{{event.organizer.getFullName }}</p>
        </div>
        <h3>{{ event.title }}</h3>
        <p>{{ event.description|nl2br }}</p>
        <div class="event-date-place-container">
            <div class="event-place">
                <img class="event-icon" src="{{ asset('images/icones/location-red-icon.svg') }}" alt="Pointeur d'une
                    carte">
                {% if event.address %}
                <address>{{event.address.getFullAddress }}</address>
                {% else %}
                <p>Adresse non renseignée</p>
                {% endif %}
            </div>
            <div class="event-date">
                <img class="event-icon" src="{{ asset('images/icones/date-red-icon.svg') }}"
                    alt="Illustration d'un calendrier">
                <time datetime="{{event.eventAt.date | date(" Y-m-dTH:i")}}">{{event.eventAt.date | date("d/m/Y à
                    H\\hi")}}</time>
            </div>
        </div>
        <div class="event-money">
            <img class="event-icon" src="{{ asset('images/icones/money-green-icon.svg') }}"
                alt="Illustration d'un billet de banque">
            {% if event.isFree %}
            <p>Gratuit</p>
            {% else %}
            <p>Dépenses à prévoir</p>
            {% endif %}
        </div>
        <div class="register">
            {% if event.maxNumberOfParticipants %}
            {% set totalParticipants = event.participants|length + 1 %}
            {% set remaining = event.maxNumberOfParticipants - totalParticipants %}
            <p>
                {{totalParticipants}}/{{event.maxNumberOfParticipants}} ({{remaining > 1 ? remaining ~ ' places
                restantes' : remaining ~ ' place restante'}})
            </p>
            {% else %}
            <p>{{(event.participants|length + 1)}} inscrit{% if (event.participants|length + 1) > 1 %}s{% endif %}</p>
            {% endif %}
            {% if app.user and (app.user in event.participants or app.user is same as(event.organizer)) %}
            <a class="button-link" href="{{ path('app_show_event', {id: event.id}) }}">Voir l'évènement</a>
            {% elseif remaining is defined and remaining == 0 %}
            <p><strong>Complet</strong></p>
            {% else %}
            <form action="{{ path('app_register_event', {id: event.id}) }}" method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('register_event_' ~ event.id) }}">
                <button type="submit" class="button-link">S'inscrire</button>
            </form>
            {% endif %}
        </div>
    </div>
    {% endfor %}
    {% include "/components/pagination.html.twig" %}
</section>
{% endblock %}