<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Jeux partage{% endblock %}</title>
    {#
    <link rel="icon" href="{{ asset('images/logo-1-0.png') }}" type="image/svg+xml" /> #}
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml" />
    <link rel="stylesheet" media="screen" href="https://fontlibrary.org//face/comic-relief" type="text/css" />
    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>

<body>
    <header>
        <div class="mobile-container">
            <a href="{{ path('app_home')}}">
                <img class="logo" src="{{ asset('images/logo-1-0.png')}}" alt="Logo du site représentant un dé">
                {# <img class="logo" src="{{ asset('favicon.svg')}}" alt="Logo du site représentant un dé"> #}
            </a>
            <button class="burger-btn" aria-label="Ouvrir le menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>

        <nav>
            <ul class="nav-list">
                <a href="{{ path('app_events') }}">
                    <li>Les événements</li>
                </a>
                <a href="{{ path('app_games') }}">
                    <li>Les jeux</li>
                </a>
                <a href="#">
                    <li>Ma bibiliothèque de jeux</li>
                </a>
                <a href="#">
                    <li>À propos</li>
                </a>
                {% if not app.user %}
                <a href="{{ path('app_login') }}">
                    <li>Se connecter</li>
                </a>
                <a href="{{ path('app_register') }}">
                    <li>S'inscrire</li>
                </a>
                {% else %}
                <a href="#">
                    <li>Mon profil</li>
                </a>
                <a href="{{ path('app_logout') }}">
                    <li>Se déconnecter</li>
                </a>
                {% endif %}
            </ul>
        </nav>
    </header>

    <main>
        {% block main %}
        {% endblock %}
    </main>
    <footer>
        <p>Footer</p>
    </footer>
</body>

</html>